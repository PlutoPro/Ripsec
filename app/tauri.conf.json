{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ripsec",
  "version": "0.1.0",
  "identifier": "io.github.plutopro.ripsec",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Ripsec",
        "width": 380,
        "height": 600,
        "minWidth": 340,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
